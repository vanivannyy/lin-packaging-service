# Salin file ini menjadi `.env` lalu isi dengan nilai asli (jangan pernah commit `.env`).

# Connection string PostgreSQL (Neon pooled — untuk runtime app / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Connection string Neon direct/non-pooler — wajib untuk prisma migrate
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret untuk menandatangani session JWT. WAJIB diganti dengan string acak & panjang di production.
# Generate contoh: openssl rand -base64 32
SESSION_SECRET="change-this-secret-in-production"
